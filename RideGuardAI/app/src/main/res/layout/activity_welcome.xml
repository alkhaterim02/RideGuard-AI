<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center" android:padding="24dp">

        <ImageView
            android:layout_width="120dp" android:layout_height="120dp"
            android:src="@drawable/ic_logo" android:contentDescription="RideGuard AI logo" />

        <TextView style="@style/RG.Title" android:gravity="center" android:textSize="34sp"
            android:layout_marginTop="12dp" android:text="RideGuard AI" />

        <TextView style="@style/RG.Body" android:gravity="center" android:layout_marginTop="8dp"
            android:text="Smart accident detection and fast emergency help for motorcycle riders." />

        <TextView android:id="@+id/demoBanner" style="@style/RG.Banner" android:visibility="gone"
            android:text="DEMO MODE: sample data only. No real SMS or alerts are sent." />

        <com.google.android.material.button.MaterialButton android:id="@+id/btnRider"
            style="@style/RG.BigButton" android:layout_marginTop="32dp" android:text="Rider Login" />

        <com.google.android.material.button.MaterialButton android:id="@+id/btnCompany"
            style="@style/RG.BigButton" android:text="Company Login" />

        <com.google.android.material.button.MaterialButton android:id="@+id/btnHelp"
            style="@style/RG.OutlinedButton" android:text="Help" />
    </LinearLayout>
</ScrollView>
