<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:minHeight="48dp" android:paddingTop="6dp" android:paddingBottom="6dp">
    <TextView android:id="@+id/rowLabel"
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:textSize="17sp" android:textColor="@color/rg_text" />
    <TextView android:id="@+id/rowValue" style="@style/RG.Chip" />
</LinearLayout>
