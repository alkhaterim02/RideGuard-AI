<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/rg_amber" android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center" android:padding="24dp">

        <TextView style="@style/RG.Text" android:gravity="center" android:textSize="30sp"
            android:textStyle="bold" android:text="⚠ Possible accident detected" />

        <TextView android:id="@+id/tvCountdown" style="@style/RG.Text" android:gravity="center"
            android:textSize="110sp" android:textStyle="bold" android:text="20" />

        <TextView style="@style/RG.Text" android:gravity="center" android:textSize="20sp"
            android:text="Emergency alert will be sent if you do not cancel." />

        <TextView android:id="@+id/tvLocation" style="@style/RG.Text" android:gravity="center"
            android:textSize="18sp" android:layout_marginTop="10dp" />

        <com.google.android.material.button.MaterialButton android:id="@+id/btnCancel"
            style="@style/RG.BigButton" android:minHeight="140dp" android:textSize="30sp"
            android:layout_marginTop="28dp" android:textColor="@color/white"
            app:backgroundTint="@color/rg_red" android:text="CANCEL ALERT" />

        <TextView style="@style/RG.Text" android:gravity="center" android:textSize="17sp"
            android:layout_marginTop="14dp"
            android:text="You can also press the physical CANCEL button on your vest." />

        <TextView android:id="@+id/tvWaiting" style="@style/RG.Text" android:gravity="center"
            android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="16dp"
            android:visibility="gone" android:text="Sending emergency alert…" />
    </LinearLayout>
</ScrollView>
