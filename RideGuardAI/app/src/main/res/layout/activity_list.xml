<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp">

    <com.google.android.material.button.MaterialButton android:id="@+id/btnAdd"
        style="@style/RG.BigButton" android:layout_marginTop="0dp" android:visibility="gone" />

    <TextView android:id="@+id/tvEmpty" style="@style/RG.Label" android:gravity="center"
        android:padding="24dp" android:visibility="gone" android:text="Nothing here yet." />

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="8dp" android:clipToPadding="false" />
</LinearLayout>
