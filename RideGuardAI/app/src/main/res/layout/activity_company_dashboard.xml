<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp">

    <LinearLayout android:id="@+id/statsGrid"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnRiders"
            style="@style/RG.OutlinedButton" android:layout_width="0dp" android:layout_weight="1"
            android:layout_marginEnd="8dp" android:text="Riders" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnHistory"
            style="@style/RG.OutlinedButton" android:layout_width="0dp" android:layout_weight="1"
            android:text="History" />
    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout style="@style/RG.Input"
        android:hint="Search rider name or incident number">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etSearch"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="text" android:textSize="17sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView style="@style/RG.Section" android:layout_marginTop="12dp"
        android:text="Emergencies and recent incidents" />

    <TextView android:id="@+id/tvEmpty" style="@style/RG.Label" android:gravity="center"
        android:padding="20dp" android:visibility="gone" android:text="No incidents found." />

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="4dp" />
</LinearLayout>
